    <!-- About -->
    <string name="about_brand">Night Screen</string>
    <string name="about_version">Version %1$s</string>
    <string name="about_privacy_title">Privacy</string>
    <string name="about_privacy_subtitle">Designed to be boring about your data</string>
    <string name="about_privacy_1" tools:ignore="PluralsCandidate">100% offline. No accounts, no analytics, no ads, no network access of any kind.</string>
    <string name="about_privacy_2">Everything is stored locally on this device. Nothing leaves it.</string>
    <string name="about_privacy_3">The dimming filter is a simple dark layer — it never intercepts or records your touches.</string>
    <string name="about_platform_title">Platform notes</string>
    <string name="about_platform_subtitle">Things worth knowing</string>
    <string name="about_platform_1">• The foreground service keeps the filter running; some OEMs (Xiaomi, Vivo, Oppo, Huawei) aggressively kill background services — the app works best when battery optimisation is left on default and the filter is toggled from the notification or Quick Settings tile.</string>
    <string name="about_platform_2">• Dimming works by layering a dark tint. It dims content, but it cannot lower the display\'s actual backlight — for that, use your device\'s own brightness control.</string>
    <string name="about_platform_3">• On some devices, system UI like the notification shade or lock screen may appear slightly brighter than the dimmed layer.</string>
    <string name="about_disclaimer">Night Screen is provided as-is. It is not medical advice — if screen use affects your sleep or eyesight, consult a professional.</string>

